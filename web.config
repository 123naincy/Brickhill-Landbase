<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical host" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.brickhillandbase\.com$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.brickhillandbase.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Strip trailing slash" stopProcessing="true">
          <match url="(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Home html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="About html to clean" stopProcessing="true">
          <match url="^about\.html$" />
          <action type="Redirect" url="/about" redirectType="Permanent" />
        </rule>
        <rule name="Sindhudurg html to clean" stopProcessing="true">
          <match url="^sindhudurg\.html$" />
          <action type="Redirect" url="/sindhudurg" redirectType="Permanent" />
        </rule>
        <rule name="Project file to clean" stopProcessing="true">
          <match url="^bhl-aaranya\.html$" />
          <action type="Redirect" url="/sindhudurg" redirectType="Permanent" />
        </rule>
        <rule name="Events html to clean" stopProcessing="true">
          <match url="^events\.html$" />
          <action type="Redirect" url="/events" redirectType="Permanent" />
        </rule>
        <rule name="Contact html to clean" stopProcessing="true">
          <match url="^contact\.html$" />
          <action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="Campaign file to clean" stopProcessing="true">
          <match url="^aaranya\.html$" />
          <action type="Redirect" url="/aaranya" redirectType="Permanent" />
        </rule>
        <rule name="Serve about" stopProcessing="true">
          <match url="^about$" />
          <action type="Rewrite" url="about.html" />
        </rule>
        <rule name="Serve sindhudurg" stopProcessing="true">
          <match url="^sindhudurg$" />
          <action type="Rewrite" url="bhl-aaranya.html" />
        </rule>
        <rule name="Serve events" stopProcessing="true">
          <match url="^events$" />
          <action type="Rewrite" url="events.html" />
        </rule>
        <rule name="Serve contact" stopProcessing="true">
          <match url="^contact$" />
          <action type="Rewrite" url="contact.html" />
        </rule>
        <rule name="Serve aaranya campaign" stopProcessing="true">
          <match url="^aaranya$" />
          <action type="Rewrite" url="aaranya.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
